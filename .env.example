# Copy this file to .env.local and fill in values. Never commit .env.local, and never paste keys into chat.
# Restart `npm run dev` after changing it.

# ---------------------------------------------------------------------------------------------
# 1. The AI coach and report (LLM). Set GROQ_API_KEY (recommended) or ANTHROPIC_API_KEY.
#    With neither, the app runs in clearly-labelled DEVELOPMENT mode (scripted coach, no AI report).
# ---------------------------------------------------------------------------------------------
GROQ_API_KEY=
# Optional. Two models are used so each has its own daily allowance on Groq:
#   GROQ_CHAT_MODEL   the spoken conversation. Default: openai/gpt-oss-20b (fast)
#   GROQ_REPORT_MODEL the written report.      Default: openai/gpt-oss-120b (more accurate)
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_REPORT_MODEL=openai/gpt-oss-120b

# Optional alternative LLM. Used when no Groq key is set, or when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: force a provider ("groq" or "anthropic") when both keys are present.
LLM_PROVIDER=

# ---------------------------------------------------------------------------------------------
# 2. Speech-to-text (Sarvam AI). Without it, the browser's own recogniser is used.
# ---------------------------------------------------------------------------------------------
SARVAM_API_KEY=
# Optional. English variety sent to Sarvam. Default: en-IN
SARVAM_LANGUAGE=en-IN
# Optional. Leave empty to use Sarvam's default model.
SARVAM_STT_MODEL=

# ---------------------------------------------------------------------------------------------
# 3. The coach's voice (Cartesia Sonic). Needs BOTH the key and the voice ID you chose.
#    Without them, the browser's own voice is used.
# ---------------------------------------------------------------------------------------------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional. Defaults: sonic-3.6 and the API version below.
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14
