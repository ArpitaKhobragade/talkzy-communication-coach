# Copy this file to .env.local and fill in values. Never commit .env.local, and never paste keys into chat.
# Restart `npm run dev` after changing it.

# ---------------------------------------------------------------------------------------------
# 1. The AI coach and report (LLM). Set GROQ_API_KEY (recommended) or ANTHROPIC_API_KEY.
#    With neither, the app runs in clearly-labelled DEVELOPMENT mode (scripted coach, no AI report).
# ---------------------------------------------------------------------------------------------
GROQ_API_KEY=
# Optional. Different models are used for the conversation and the report, so each has its own allowance on Groq:
#   GROQ_CHAT_MODELS  the spoken conversation, best first, taken in turn when one is at its per-minute limit.
#                     Default: qwen/qwen3.8-27b,openai/gpt-oss-20b,openai/gpt-oss-120b (leave it empty to use this).
#   GROQ_REPORT_MODEL the written report.      Default: openai/gpt-oss-120b (more accurate)
# Groq counts tokens per model per minute (8,000 on the free plan, about 3 coach turns a minute), so a busy app needs a paid Groq plan.
GROQ_CHAT_MODELS=
GROQ_REPORT_MODEL=openai/gpt-oss-120b

# Optional alternative LLM. Used when no Groq key is set, or when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: force a provider ("groq" or "anthropic") when both keys are present.
LLM_PROVIDER=

# ---------------------------------------------------------------------------------------------
# 2. Speech-to-text (Sarvam AI). Without it, the browser's own recogniser is used.
# ---------------------------------------------------------------------------------------------
SARVAM_API_KEY=
# Optional. English variety sent to Sarvam. Default: en-IN
SARVAM_LANGUAGE=en-IN
# Optional. Leave empty to use Sarvam's default model.
SARVAM_STT_MODEL=

# ---------------------------------------------------------------------------------------------
# 3. The coach's voice (Cartesia Sonic). Needs BOTH the key and the voice ID you chose.
#    Without them, the browser's own voice is used.
# ---------------------------------------------------------------------------------------------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optional. Defaults: sonic-3.6 and the API version below.
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14
# This is the ONLY coach voice. If Cartesia fails (for example no credit) the coach is silent and her words are shown as text.
# Set TTS_BACKUP=sarvam only if you want Sarvam's own voice to take over then (a second voice).
TTS_BACKUP=

# ---------------------------------------------------------------------------------------------
# 4. Optional voice settings
# ---------------------------------------------------------------------------------------------
# Only used when TTS_BACKUP=sarvam (see section 3): Sarvam's own voice, taking over when Cartesia fails.
# Optional. Sarvam voice used as that backup. Default: priya
SARVAM_TTS_SPEAKER=priya
# Optional. "on" asks Sarvam for word-for-word text. Leave it off: it writes English in Hindi letters.
SARVAM_VERBATIM=
# Optional. Live words (shown while the student is still speaking) use Groq's Whisper first, with the GROQ_API_KEY above.
# Set to "off" to use only Sarvam for live words. GROQ_STT_MODEL defaults to whisper-large-v3-turbo.
GROQ_STT_PARTIALS=
GROQ_STT_MODEL=

# ---------------------------------------------------------------------------------------------
# 5. Admin panel (/admin): where the college sees every student's progress
# ---------------------------------------------------------------------------------------------
# The password for /admin (at least 8 characters). Without it the admin panel stays closed.
ADMIN_PASSWORD=
# Optional. Signs the admin's login cookie. Defaults to a value made from the password.
ADMIN_SESSION_SECRET=
# The database that keeps the students' progress (Upstash Redis). Vercel adds these two by itself when you add Upstash Redis
# in its Marketplace (it may call them KV_REST_API_URL and KV_REST_API_TOKEN instead, which also work).
# Without them the panel keeps the data in the server's memory only, and forgets it when the server restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
